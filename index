    envMapIntensity: 0.6
  }));
  facade.scale.set(width, height, depth);
  facade.position.set(x, height / 2 - 0.12, 0);
  group.add(facade);

  const windowColor = seed % 2 ? 0x58cfff : 0xff5e6b;
  const windowsMaterial = materialFor('windows-' + windowColor, {
    color: windowColor,
    emissive: windowColor,
    emissiveIntensity: 3.4,
    roughness: 0.35,
    toneMapped: false
  });
  const rows = Math.min(6, Math.max(3, Math.floor(height / 1.55)));
  for (let row = 0; row < rows; row += 1) {
    if ((row + seed) % 4 === 0) continue;
    const strip = new THREE.Mesh(shared.unitBox, windowsMaterial);
    strip.scale.set(0.055, 0.28, depth * 0.67);
    strip.position.set(x - side * (width / 2 + 0.035), 1.05 + row * 1.28, 0);
    group.add(strip);
  }

  const roof = new THREE.Mesh(shared.unitBox, materialFor('roof-trim', {
    color: 0x8fdcff,
    emissive: 0x4dafff,
    emissiveIntensity: 2.4,
    toneMapped: false
  }));
  roof.scale.set(width + 0.18, 0.07, depth + 0.18);
  roof.position.set(x, height - 0.08, 0);
  group.add(roof);
  return group;
}

function makeRocks(side, seed) {
  const group = new THREE.Group();
  const rockMaterial = physicalMaterialFor('desert-rock', {
    color: 0x75402f,
    roughness: 0.84,
    metalness: 0.02,
    clearcoat: 0.08
  });
  const count = 2 + (seed % 2);
  for (let i = 0; i < count; i += 1) {
    const rock = new THREE.Mesh(shared.rock, rockMaterial);
    const size = random(1.3, 3.8);
    rock.scale.set(size * random(0.8, 1.35), size * random(1, 2.1), size);
    rock.position.set(side * random(10, 17), rock.scale.y * 0.55 - 0.25, random(-7, 7));
    rock.rotation.set(random(-0.2, 0.2), random(0, Math.PI), random(-0.18, 0.18));
    rock.castShadow = !LOW_POWER;
    group.add(rock);
  }
  return group;
}

function makeBillboard(side, theme) {
  const group = new THREE.Group();
  const texture = makeSignTexture(theme.id === 'city' ? 'REDLINE' : 'FULL SEND', theme.id === 'city' ? '#ef2933' : '#ff9b4a');
  const material = new THREE.MeshBasicMaterial({
    map: texture,
    transparent: false,
    side: THREE.DoubleSide,
    toneMapped: false
  });
  const board = new THREE.Mesh(new THREE.PlaneGeometry(4.7, 1.46), material);
  board.position.set(side * 9.2, 3.45, random(-9, 9));
  board.rotation.y = side > 0 ? -Math.PI / 2 : Math.PI / 2;
  group.add(board);
  const postMaterial = materialFor('billboard-post', { color: 0x262a31, metalness: 0.8, roughness: 0.32 });
  const post = new THREE.Mesh(shared.bar, postMaterial);
  post.scale.y = 2.7;
  post.position.set(side * 9.2, 1.4, board.position.z);
  group.add(post);
  return group;
}

function carMaterials(definition) {
  return {
    paint: new THREE.MeshPhysicalMaterial({
      color: definition.color,
      metalness: 0.76,
      roughness: 0.2,
      clearcoat: 1,
      clearcoatRoughness: 0.075,
      envMapIntensity: 1.25
    }),
    dark: new THREE.MeshPhysicalMaterial({
      color: definition.dark,
      metalness: 0.62,
      roughness: 0.3,
      clearcoat: 0.45,
      clearcoatRoughness: 0.15
    }),
    glass: new THREE.MeshPhysicalMaterial({
      color: definition.glass,
      metalness: 0.08,
      roughness: 0.08,
      transmission: 0.16,
      transparent: true,
      opacity: 0.78,
      clearcoat: 1,
      clearcoatRoughness: 0.04,
      envMapIntensity: 1.45
    }),
    chrome: materialFor('chrome', {
      color: 0xbac0c9,
      metalness: 0.92,
      roughness: 0.2
    }),
    tire: materialFor('tire', {
      color: 0x07080a,
      roughness: 0.83,
      metalness: 0.05
    }),
    wheel: materialFor('wheel', {
      color: 0x4d535c,
      roughness: 0.23,
      metalness: 0.94
    }),
    brake: new THREE.MeshStandardMaterial({
      color: definition.accent,
      emissive: definition.accent,
      emissiveIntensity: 0.48,
      metalness: 0.55,
      roughness: 0.33
    }),
    headlight: materialFor('headlight', {
      color: 0xeaf6ff,
      emissive: 0xccecff,
      emissiveIntensity: 7,
      toneMapped: false
    }),
    tail: materialFor('tail', {
      color: 0xff1a24,
      emissive: 0xff101b,
      emissiveIntensity: 6,
      toneMapped: false
    })
  };
}

function addCarMesh(group, geometry, material, position, scale, rotation) {
  const mesh = new THREE.Mesh(geometry, material);
  mesh.position.set(position[0], position[1], position[2]);
  if (scale) mesh.scale.set(scale[0], scale[1], scale[2]);
  if (rotation) mesh.rotation.set(rotation[0], rotation[1], rotation[2]);
  mesh.castShadow = true;
  mesh.receiveShadow = true;
  group.add(mesh);
  return mesh;
}

function createCar(id, isPlayer) {
  const definition = CARS[id];
  const materials = carMaterials(definition);
  const group = new THREE.Group();
  group.name = id;
  group.userData.definition = definition;
  group.userData.wheels = [];
  group.userData.paint = materials.paint;
  group.userData.brakeMaterial = materials.brake;

  const style = definition.style;
  const heightLift = style === 'buggy' ? 0.17 : 0;
  const bodyScale = style === 'cruiser' ? [1.07, 1.08, 1.08] :
    style === 'jet' ? [1, 0.83, 1.04] :
    style === 'wedge' ? [1.03, 0.72, 1.05] :
    style === 'coupe' ? [0.98, 1.04, 1] : [1.03, 1, 1.02];

  addCarMesh(group, shared.lower, materials.dark, [0, 0.49 + heightLift, 0], bodyScale);
  addCarMesh(group, shared.body, materials.paint, [0, 0.72 + heightLift, 0], bodyScale);

  const hoodScale = style === 'wedge' ? [1.05, 0.55, 1.12] :
    style === 'buggy' ? [0.93, 0.78, 0.84] : [1, 1, 1];
  addCarMesh(group, shared.hood, materials.paint, [0, 0.98 + heightLift, -1.26], hoodScale);

  const cabinScale = style === 'jet' ? [0.9, 0.78, 1.08] :
    style === 'wedge' ? [0.95, 0.64, 1.08] :
    style === 'cruiser' ? [1.03, 1.03, 1.06] :
    style === 'coupe' ? [1, 1.04, 1.04] : [1, 1, 1];
  const cabinY = style === 'wedge' ? 1.12 : 1.2 + heightLift;
  const cabinZ = style === 'gt' ? 0.17 : style === 'cruiser' ? 0.08 : 0;
  addCarMesh(group, shared.cabin, materials.glass, [0, cabinY, cabinZ], cabinScale);
  addCarMesh(group, shared.roof, materials.paint, [0, cabinY + 0.36 * cabinScale[1], cabinZ + 0.03], [
    cabinScale[0], 1, cabinScale[2]
  ]);

  addCarMesh(group, shared.bumper, materials.dark, [0, 0.58 + heightLift, -2.12], [1, 1, 1]);
  addCarMesh(group, shared.bumper, materials.dark, [0, 0.58 + heightLift, 2.12], [1, 1, 1]);
  addCarMesh(group, shared.grille, materials.dark, [0, 0.73 + heightLift, -2.225], [1, 1, 1]);
  addCarMesh(group, shared.plate, materials.chrome, [0, 0.69 + heightLift, 2.225], [1, 1, 1]);

  [-0.67, 0.67].forEach(function (x) {
    addCarMesh(group, shared.light, materials.headlight, [x, 0.9 + heightLift, -2.205], [1, 1, 1]);
    addCarMesh(group, shared.light, materials.tail, [x, 0.86 + heightLift, 2.205], [0.94, 0.92, 1]);
  });

  const wheelZ = style === 'cruiser' ? 1.4 : 1.32;
  const wheelX = style === 'buggy' ? 1.12 : 1.03;
  const wheelScale = style === 'buggy' ? 1.13 : style === 'wedge' ? 0.94 : 1;
  [-1, 1].forEach(function (side) {
    [-wheelZ, wheelZ].forEach(function (z) {
      const wheelAssembly = new THREE.Group();
      wheelAssembly.position.set(side * wheelX, 0.48 + heightLift, z);
      const tire = addCarMesh(wheelAssembly, shared.wheel, materials.tire, [0, 0, 0], [
        wheelScale, wheelScale, wheelScale
      ], [0, 0, Math.PI / 2]);
      const rim = addCarMesh(wheelAssembly, shared.rim, materials.wheel, [0, 0, 0], [
        wheelScale, wheelScale, wheelScale
      ], [0, 0, Math.PI / 2]);
      const brake = addCarMesh(wheelAssembly, shared.disc, materials.brake, [0, 0, 0], [
        wheelScale, wheelScale, wheelScale
      ], [0, 0, Math.PI / 2]);
      tire.castShadow = rim.castShadow = brake.castShadow = true;
      group.userData.wheels.push(wheelAssembly);
      group.add(wheelAssembly);
    });
  });

  if (style === 'gt' || style === 'jet' || style === 'wedge') {
    addCarMesh(group, shared.spoilerPost, materials.dark, [-0.58, 1.16, 1.82], [1, 1, 1]);
    addCarMesh(group, shared.spoilerPost, materials.dark, [0.58, 1.16, 1.82], [1, 1, 1]);
    addCarMesh(group, shared.spoilerWing, materials.paint, [0, 1.34, 1.82], [
      style === 'jet' ? 1.08 : 1, 1, style === 'wedge' ? 1.25 : 1
    ]);
  }

  if (style === 'jet') {
    addCarMesh(group, shared.aeroFin, materials.paint, [-0.9, 0.67, -1.66], [1, 1, 1]);
    addCarMesh(group, shared.aeroFin, materials.paint, [0.9, 0.67, -1.66], [1, 1, 1]);
  }

  if (style === 'buggy') {
    const bars = [
      [-0.66, 1.35, 0.34, 0, 0, -0.55],
      [0.66, 1.35, 0.34, 0, 0, 0.55],
      [-0.66, 1.35, -0.34, 0, 0, 0.55],
      [0.66, 1.35, -0.34, 0, 0, -0.55]
    ];
    bars.forEach(function (entry) {
      addCarMesh(group, shared.bar, materials.dark, entry.slice(0, 3), [1, 1.2, 1], entry.slice(3));
    });
    addCarMesh(group, shared.spoilerWing, materials.dark, [0, 1.72, 0], [0.8, 1, 0.55]);
  }

  if (style === 'coupe') {
    const accentMaterial = new THREE.MeshStandardMaterial({
      color: definition.accent,
      emissive: definition.accent,
      emissiveIntensity: 1.1,
      metalness: 0.55,
      roughness: 0.25
    });
    [-0.96, 0.96].forEach(function (x) {
      addCarMesh(group, shared.aeroFin, accentMaterial, [x, 0.76, 0.42], [0.48, 0.5, 1.8], [0, 0, 0]);
    });
  }

  if (style === 'cruiser') {
    const redLamp = new THREE.MeshStandardMaterial({
      color: 0xff2631,
      emissive: 0xff1722,
      emissiveIntensity: 5,
      toneMapped: false
    });
    const blueLamp = new THREE.MeshStandardMaterial({
      color: 0x428cff,
      emissive: 0x2574ff,
      emissiveIntensity: 5,
      toneMapped: false
    });
    addCarMesh(group, shared.lightBar, redLamp, [-0.31, 1.73, 0.12], [1, 1, 1]);
    addCarMesh(group, shared.lightBar, blueLamp, [0.31, 1.73, 0.12], [1, 1, 1]);
    group.userData.sirenMaterials = [redLamp, blueLamp];
  }

  const glow = new THREE.Mesh(
    new THREE.PlaneGeometry(3.4, 5.3),
    new THREE.MeshBasicMaterial({
      map: glowTexture,
      color: definition.accent,
      transparent: true,
      opacity: isPlayer ? 0.23 : 0.08,
      blending: THREE.AdditiveBlending,
      depthWrite: false
    })
  );
  glow.rotation.x = -Math.PI / 2;
  glow.position.y = 0.055;
  group.add(glow);
  group.userData.glow = glow;

  if (isPlayer) {
    shieldMesh = new THREE.Mesh(shared.shield, new THREE.MeshPhysicalMaterial({
      color: definition.accent,
      emissive: definition.accent,
      emissiveIntensity: 1.1,
      transparent: true,
      opacity: 0.18,
      roughness: 0.08,
      metalness: 0.18,
      side: THREE.DoubleSide,
      depthWrite: false,
      blending: THREE.AdditiveBlending
    }));
    shieldMesh.position.y = 0.82;
    shieldMesh.scale.set(1.05, 0.68, 1.85);
    shieldMesh.visible = false;
    group.add(shieldMesh);

    abilityHalo = new THREE.Mesh(shared.halo, new THREE.MeshBasicMaterial({
      color: definition.accent,
      transparent: true,
      opacity: 0.75,
      blending: THREE.AdditiveBlending,
      depthWrite: false
    }));
    abilityHalo.rotation.x = Math.PI / 2;
    abilityHalo.position.y = 0.14;
    abilityHalo.visible = false;
    group.add(abilityHalo);
  }

  group.scale.setScalar(isPlayer ? 1.02 : 0.94);
  if (!isPlayer && LOW_POWER) {
    group.traverse(function (child) {
      if (child.isMesh) {
        child.castShadow = false;
        child.receiveShadow = false;
      }
    });
  }
  return group;
}

function createPlayer() {
  playerRoot = new THREE.Group();
  playerRoot.position.set(0, 0, PLAYER_Z);
  scene.add(playerRoot);
  replacePlayerCar(state.selectedCar);
}

function replacePlayerCar(id) {
  if (playerCar) playerRoot.remove(playerCar);
  playerCar = createCar(id, true);
  playerRoot.add(playerCar);
  state.selectedCar = id;
  safeStorageSet('redline3d.car', id);
  paintCarSelection();
}

function createTraffic() {
  const colors = ['phantom', 'bolt', 'timestamp', 'rose', 'siren', 'redd', 'phantom', 'rose', 'bolt'];
  for (let i = 0; i < colors.length; i += 1) {
    const car = createCar(colors[i], false);
    car.visible = false;
    scene.add(car);
    const entry = {
      mesh: car,
      lane: i % 3,
      targetLane: i % 3,
      speedFactor: random(0.52, 0.72),
      laneTimer: random(1.6, 4.8),
      passed: false
    };
    traffic.push(entry);
  }
}

function createPickups() {
  const shellMaterial = new THREE.MeshPhysicalMaterial({
    color: 0xcfeaff,
    emissive: 0x4aa8ff,
    emissiveIntensity: 1.6,
    transmission: 0.52,
    transparent: true,
    opacity: 0.54,
    roughness: 0.04,
    metalness: 0.08,
    depthWrite: false
  });
  const coreMaterial = new THREE.MeshStandardMaterial({
    color: 0xffd34f,
    emissive: 0xff9d28,
    emissiveIntensity: 4,
    metalness: 0.5,
    roughness: 0.18,
    toneMapped: false
  });
  const ringMaterial = new THREE.MeshBasicMaterial({
    color: 0x7bdcff,
    transparent: true,
    opacity: 0.8,
    blending: THREE.AdditiveBlending,
    depthWrite: false,
    toneMapped: false
  });
  for (let i = 0; i < 3; i += 1) {
    const group = new THREE.Group();
    const shell = new THREE.Mesh(shared.pickupSphere, shellMaterial);
    const core = new THREE.Mesh(shared.pickupCore, coreMaterial);
    const ring = new THREE.Mesh(shared.pickupRing, ringMaterial);
    ring.rotation.x = Math.PI / 2;
    group.add(shell, core, ring);
    group.visible = false;
    scene.add(group);
    pickups.push({ mesh: group, lane: 1, spin: random(0, Math.PI * 2) });
  }
}

function createRivals() {
  ['bolt', 'phantom'].forEach(function (id, index) {
    const car = createCar(id, false);
    car.visible = false;
    scene.add(car);
    rivalCars.push({
      mesh: car,
      car: id,
      progress: 0,
      lane: index === 0 ? 0 : 2,
      targetLane: index === 0 ? 0 : 2,
      think: random(1.2, 2.2),
      paceNoise: random(0, 8)
    });
  });
}

function createSpeedLines() {
  const lineCount = LOW_POWER ? 32 : 58;
  speedLinePositions = new Float32Array(lineCount * 6);
  for (let i = 0; i < lineCount; i += 1) resetSpeedLine(i, true);
  const geometry = new THREE.BufferGeometry();
  geometry.setAttribute('position', new THREE.BufferAttribute(speedLinePositions, 3));
  const material = new THREE.LineBasicMaterial({
    color: 0xf5f8ff,
    transparent: true,
    opacity: 0,
    blending: THREE.AdditiveBlending,
    depthWrite: false
  });
  speedLines = new THREE.LineSegments(geometry, material);
  speedLines.frustumCulled = false;
  scene.add(speedLines);
}

function resetSpeedLine(index, initial) {
  const base = index * 6;
  const side = Math.random() < 0.5 ? -1 : 1;
  const x = side * random(4.8, 15);
  const y = random(0.25, 8.5);
  const z = initial ? random(-80, 9) : random(-90, -55);
  const length = random(3.5, 10);
  speedLinePositions[base] = x;
  speedLinePositions[base + 1] = y;
  speedLinePositions[base + 2] = z;
  speedLinePositions[base + 3] = x;
  speedLinePositions[base + 4] = y;
  speedLinePositions[base + 5] = z - length;
}

function resetTraffic(entry, z) {
  entry.lane = Math.floor(Math.random() * 3);
  entry.targetLane = entry.lane;
  entry.speedFactor = random(0.48, 0.74);
  entry.laneTimer = random(2.2, 6);
  entry.passed = false;
  entry.mesh.position.set(LANE_X[entry.lane], 0, z);
  entry.mesh.rotation.set(0, 0, 0);
  entry.mesh.visible = true;
}

function resetPickup(entry, z) {
  entry.lane = Math.floor(Math.random() * 3);
  entry.mesh.position.set(LANE_X[entry.lane], 1.05, z);
  entry.mesh.visible = true;
}

function resetWorldActors() {
  let z = -34;
  traffic.forEach(function (entry, index) {
    z -= index % 3 === 0 ? random(22, 31) : random(13, 22);
    resetTraffic(entry, z);
  });
  pickups.forEach(function (entry, index) {
    resetPickup(entry, -92 - index * 105 - random(0, 25));
  });
  rivalCars.forEach(function (entry, index) {
    entry.progress = index === 0 ? random(0, 4) : random(-5, 1);
    entry.lane = index === 0 ? 0 : 2;
    entry.targetLane = entry.lane;
    entry.think = random(1.1, 2.3);
    entry.mesh.position.set(LANE_X[entry.lane], 0, PLAYER_Z - 4 - index * 4);
    entry.mesh.visible = state.mode === 'rivals';
  });
  if (finishGate) finishGate.visible = false;
}

function resize() {
  if (!renderer || !camera) return;
  const width = Math.max(1, window.innerWidth);
  const height = Math.max(1, window.innerHeight);
  renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, LOW_POWER ? 1.15 : 1.65));
  renderer.setSize(width, height, false);
  camera.aspect = width / height;
  camera.near = 0.1;
  camera.far = 520;
  camera.updateProjectionMatrix();
}

function paintCarSelection() {
  const definition = CARS[state.selectedCar];
  const index = CAR_ORDER.indexOf(state.selectedCar);
  ui.selectedSwatch.style.background = definition.colorCss;
  ui.selectedName.textContent = definition.name;
  ui.selectedPower.textContent = definition.power;
  ui.garageNumber.textContent = String(index + 1).padStart(2, '0');
  ui.garageCarName.textContent = definition.name;
  ui.garageCarClass.textContent = definition.className;
  ui.garagePowerName.textContent = definition.power;
  ui.garagePowerDescription.textContent = definition.description;
  ui.driveCarName.textContent = definition.name;
  $('.car-card').forEach(function (button) {
    const active = button.dataset.car === state.selectedCar;
    button.classList.toggle('active', active);
    button.setAttribute('aria-selected', active ? 'true' : 'false');
  });
}

function setPanel(element, active) {
  element.classList.toggle('active', active);
  element.setAttribute('aria-hidden', active ? 'false' : 'true');
}

function showStart() {
  state.phase = 'menu';
  state.boosting = false;
  state.abilityTime = 0;
  state.shieldTime = 0;
  setPanel(ui.startScreen, true);
  setPanel(ui.garageScreen, false);
  setPanel(ui.hud, false);
  setPanel(ui.touch, false);
  setPanel(ui.pausePanel, false);
  setPanel(ui.gameOverPanel, false);
  setPanel(ui.countdown, false);
  traffic.forEach(function (entry) { entry.mesh.visible = false; });
  pickups.forEach(function (entry) { entry.mesh.visible = false; });
  rivalCars.forEach(function (entry) { entry.mesh.visible = false; });
  if (finishGate) finishGate.visible = false;
  playerRoot.position.x = 0;
  playerRoot.position.z = PLAYER_Z;
  playerRoot.rotation.set(0, 0, 0);
  playerCar.rotation.set(0, 0, 0);
  playerCar.userData.paint.emissive.setHex(0x000000);
  playerCar.userData.paint.emissiveIntensity = 0;
  playerCar.userData.glow.material.opacity = 0.23;
  if (shieldMesh) shieldMesh.visible = false;
  if (abilityHalo) abilityHalo.visible = false;
  audioSystem.setEngine(false);
}

function showGarage() {
  state.phase = 'garage';
  setPanel(ui.startScreen, false);
  setPanel(ui.garageScreen, true);
  setPanel(ui.hud, false);
  setPanel(ui.touch, false);
  paintCarSelection();
}

function startRace() {
  state.phase = 'countdown';
  state.lane = 1;
  state.distance = 0;
  state.speed = 0;
  state.boost = 1;
  state.boosting = false;
  state.ability = 0.25;
  state.abilityTime = 0;
  state.shieldTime = 0;
  state.itemBurst = 0;
  state.item = null;
  state.nearMisses = 0;
  state.crashedTime = 0;
  state.countdownTime = 0;
  state.currentCount = -1;
  state.themeIndex = 0;
  state.runWasBest = false;
  state.racePlace = 1;
  playerRoot.position.set(0, 0, PLAYER_Z);
  playerRoot.rotation.set(0, 0, 0);
  playerCar.rotation.set(0, 0, 0);
  playerCar.userData.paint.emissive.setHex(0x000000);
  playerCar.userData.paint.emissiveIntensity = 0;
  if (shieldMesh) shieldMesh.visible = false;
  if (abilityHalo) abilityHalo.visible = false;
  roadSegments.forEach(function (segment, index) {
    segment.position.z = 12 - index * SEGMENT_LENGTH;
    if (segment.userData.theme !== THEMES[0].id) populateDecor(segment, THEMES[0]);
  });
  resetWorldActors();
  setTheme(0, true);
  updateItemUI();
  setPanel(ui.startScreen, false);
  setPanel(ui.garageScreen, false);
  setPanel(ui.hud, true);
  setPanel(ui.touch, true);
  setPanel(ui.pausePanel, false);
  setPanel(ui.gameOverPanel, false);
  setPanel(ui.countdown, true);
  ui.position.classList.toggle('visible', state.mode === 'rivals');
  ui.resultPlaceWrap.style.display = state.mode === 'rivals' ? '' : 'none';
  audioSystem.unlock();
  audioSystem.setEngine(true);
  paintHud(true);
}

function pauseRace() {
  if (state.phase !== 'running' && state.phase !== 'countdown') return;
  state.phase = 'paused';
  state.boosting = false;
  ui.boostButton.classList.remove('held');
  setPanel(ui.pausePanel, true);
  audioSystem.setEngine(false);
}

function resumeRace() {
  if (state.phase !== 'paused') return;
  state.phase = 'running';
  setPanel(ui.pausePanel, false);
  audioSystem.setEngine(true);
  lastFrame = performance.now();
}

function crash(reason) {
  if (state.phase !== 'running') return;
  if (isProtected()) return;
  state.phase = 'crashed';
  state.crashedTime = 0;
  state.boosting = false;
  state.shake = 1;
  ui.boostButton.classList.remove('held');
  ui.impact.classList.remove('hit');
  void ui.impact.offsetWidth;
  ui.impact.classList.add('hit');
  playerRoot.rotation.z = random(-0.22, 0.22);
  burstAt(playerRoot.position.clone().add(new THREE.Vector3(0, 0.7, -0.5)), 0xff3b32, 32);
  audioSystem.crash();
  state.crashReason = reason || 'You clipped traffic.';
}

function finishRace(reason, won) {
  if (state.phase === 'ended') return;
  state.phase = 'ended';
  state.boosting = false;
  ui.boostButton.classList.remove('held');
  audioSystem.setEngine(false);
  const rounded = Math.max(0, Math.floor(state.distance));
  const previousBest = state.best;
  if (rounded > state.best) {
    state.best = rounded;
    state.runWasBest = true;
    safeStorageSet('redline3d.best', String(state.best));
  }
  ui.menuBest.textContent = String(state.best);
  ui.resultDistance.textContent = String(rounded);
  ui.resultBest.textContent = String(state.best);
  ui.newBest.classList.toggle('show', state.runWasBest && state.best > previousBest);
  ui.resultTitle.textContent = won ? 'Finish line' : 'Race over';
  ui.resultReason.textContent = reason;
  ui.resultKicker.textContent = won ? 'RIVAL RUN COMPLETE' : 'RUN COMPLETE';
  if (state.mode === 'rivals') {
    const place = calculatePlace();
    ui.resultPlace.textContent = place === 1 ? '1st' : place === 2 ? '2nd' : '3rd';
  }
  setPanel(ui.touch, false);
  window.setTimeout(function () {
    if (state.phase === 'ended') setPanel(ui.gameOverPanel, true);
  }, 320);
}

function moveLane(direction) {
  if (state.phase !== 'running' && state.phase !== 'countdown') return;
  const next = clamp(state.lane + direction, 0, 2);
  if (next === state.lane) {
    state.shake = Math.max(state.shake, 0.12);
    return;
  }
  state.lane = next;
  audioSystem.tick();
}

function setBoosting(active) {
  if (state.phase !== 'running') active = false;
  state.boosting = active && state.boost > 0.012;
  ui.boostButton.classList.toggle('held', state.boosting);
}

function fireAbility() {
  if (state.phase !== 'running' || state.ability < 0.999 || state.abilityTime > 0) return;
  const definition = CARS[state.selectedCar];
  state.ability = 0;
  state.abilityTime = 5;
  abilityHalo.visible = true;
  playerCar.userData.paint.emissive.setHex(definition.accent);
  playerCar.userData.paint.emissiveIntensity = 0.8;
  if (definition.powerType === 'storm') {
    clearTrafficAhead(7);
  } else if (definition.powerType === 'bloom') {
    state.shieldTime = Math.max(state.shieldTime, 7);
  } else if (definition.powerType === 'siren') {
    traffic.forEach(function (entry) {
      if (entry.mesh.position.z < PLAYER_Z && entry.mesh.position.z > -80) {
        entry.targetLane = entry.lane === state.lane ? (entry.lane === 0 ? 1 : entry.lane - 1) : entry.lane;
      }
    });
  }
  showToast(definition.power + ' ACTIVE');
  burstAt(playerRoot.position.clone().add(new THREE.Vector3(0, 0.6, 0)), definition.accent, 36);
  audioSystem.ability();
}

function isProtected() {
  const power = CARS[state.selectedCar].powerType;
  return state.shieldTime > 0 || (state.abilityTime > 0 &&
    (power === 'burn' || power === 'phase' || power === 'bloom' || power === 'siren'));
}

function clearTrafficAhead(limit) {
  const targets = traffic
    .filter(function (entry) { return entry.mesh.visible && entry.mesh.position.z < PLAYER_Z + 1; })
    .sort(function (a, b) { return b.mesh.position.z - a.mesh.position.z; })
    .slice(0, limit);
  targets.forEach(function (entry, index) {
    burstAt(entry.mesh.position.clone().add(new THREE.Vector3(0, 0.8, 0)), 0xffdf35, 20);
    resetTraffic(entry, -155 - index * 18 - random(0, 12));
  });
  state.shake = Math.max(state.shake, 0.35);
}

function collectPickup(entry) {
  const item = state.item;
  state.ability = clamp(state.ability + 0.12, 0, 1);
  state.boost = clamp(state.boost + 0.2, 0, 1);
  if (!item) {
    state.item = pick(['nitro', 'shield', 'pulse']);
    showToast(state.item === 'nitro' ? 'NITRO CAN COLLECTED' :
      state.item === 'shield' ? 'AEGIS SHIELD COLLECTED' : 'PULSE CHARGE COLLECTED');
  } else {
    showToast('CHARGE + NITRO');
  }
  burstAt(entry.mesh.position.clone(), 0x68d8ff, 24);
  audioSystem.pickup();
  updateItemUI();
  const farthest = Math.min.apply(null, pickups.map(function (pickup) { return pickup.mesh.position.z; }));
  resetPickup(entry, farthest - random(90, 135));
}

function useItem() {
  if (state.phase !== 'running' || !state.item) return;
  if (state.item === 'nitro') {
    state.boost = clamp(state.boost + 0.55, 0, 1);
    state.itemBurst = 2.6;
    showToast('NITRO SURGE');
  } else if (state.item === 'shield') {
    state.shieldTime = Math.max(state.shieldTime, 7);
    showToast('SHIELD ONLINE');
  } else if (state.item === 'pulse') {
    clearTrafficAhead(4);
    showToast('LANE PULSE');
  }
  state.item = null;
  updateItemUI();
  audioSystem.ability();
}

function updateItemUI() {
  const item = state.item;
  ui.itemButton.disabled = !item;
  ui.itemIcon.textContent = item === 'nitro' ? 'N' : item === 'shield' ? 'S' : item === 'pulse' ? 'P' : '?';
  ui.itemLabel.textContent = item ? item.toUpperCase() : 'EMPTY';
}

function setTheme(index, immediate) {
  state.themeIndex = index % THEMES.length;
  const theme = THEMES[state.themeIndex];
  ui.district.textContent = theme.name;
  const dot = $('.district-chip i');
  if (dot) {
    dot.style.background = '#' + theme.light.getHexString();
    dot.style.boxShadow = '0 0 10px #' + theme.light.getHexString();
  }
  if (immediate) {
    scene.background.copy(theme.sky);
    scene.fog.color.copy(theme.fog);
    roadMaterial.color.copy(theme.road);
    shoulderMaterial.color.copy(theme.shoulder);
  } else {
    showToast('ENTERING ' + theme.name);
  }
}

function showToast(text) {
  ui.toast.textContent = text;
  ui.toast.classList.add('show');
  state.toastTimer = 2;
}

function showNearMiss() {
  state.nearMisses += 1;
  state.ability = clamp(state.ability + 0.055, 0, 1);
  state.distance += 50;
  ui.combo.classList.remove('show');
  void ui.combo.offsetWidth;
  ui.combo.classList.add('show');
  state.comboTimer = 1.1;
  audioSystem.nearMiss();
}

function updateCountdown(dt) {
  state.countdownTime += dt;
  const step = Math.floor(state.countdownTime);
  if (step !== state.currentCount) {
    state.currentCount = step;
    const lights = $('.start-lights i');
    lights.forEach(function (light, index) {
      light.className = step >= 3 ? 'go' : index <= step ? 'lit' : '';
    });
    ui.countdownValue.textContent = step >= 3 ? 'GO' : String(3 - step);
    ui.countdownValue.classList.remove('pop');
    void ui.countdownValue.offsetWidth;
    ui.countdownValue.classList.add('pop');
    audioSystem.count(step >= 3);
  }
  if (state.countdownTime >= 3.62) {
    state.phase = 'running';
    setPanel(ui.countdown, false);
  }
}

function updateRace(dt) {
  if (state.phase === 'countdown') {
    updateCountdown(dt);
    updateWorld(0, dt);
    updatePlayer(dt, 0);
    return;
  }

  if (state.phase === 'crashed') {
    state.crashedTime += dt;
    state.speed = damp(state.speed, 0, 5.5, dt);
    const worldSpeed = state.speed * 0.14;
    updateWorld(worldSpeed, dt);
    playerRoot.rotation.y += dt * 2.7;
    playerRoot.rotation.z = damp(playerRoot.rotation.z, 0.55, 2.8, dt);
    if (state.crashedTime > 0.72) finishRace(state.crashReason, false);
    return;
  }

  if (state.phase !== 'running') return;

  if (state.toastTimer > 0) {
    state.toastTimer -= dt;
    if (state.toastTimer <= 0) ui.toast.classList.remove('show');
  }
  if (state.comboTimer > 0) {
    state.comboTimer -= dt;
    if (state.comboTimer <= 0) ui.combo.classList.remove('show');
  }

  if (state.boosting && state.boost > 0) {
    state.boost = Math.max(0, state.boost - dt * 0.31);
    if (state.boost <= 0.005) setBoosting(false);
  } else {
    state.boost = Math.min(1, state.boost + dt * 0.105);
  }

  state.ability = Math.min(1, state.ability + dt / 24);
  state.abilityTime = Math.max(0, state.abilityTime - dt);
  state.shieldTime = Math.max(0, state.shieldTime - dt);
  state.itemBurst = Math.max(0, state.itemBurst - dt);

  const distancePace = Math.min(80, state.distance * 0.025);
  let targetSpeed = 186 + distancePace;
  if (state.boosting) targetSpeed *= 1.31;
  if (state.itemBurst > 0) targetSpeed *= 1.22;
  if (state.abilityTime > 0) targetSpeed *= 1.39;
  state.speed = damp(state.speed, targetSpeed, state.boosting ? 2.5 : 1.65, dt);

  const worldSpeed = state.speed * 0.14;
  state.distance += (state.speed / 3.6) * dt;
  updatePlayer(dt, worldSpeed);
  updateWorld(worldSpeed, dt);
  updateTraffic(worldSpeed, dt);
  updatePickups(worldSpeed, dt);
  updateRivals(dt);
  updateAbilities(dt);
  checkTheme();

  if (state.mode === 'rivals' && state.distance >= FINISH_DISTANCE) {
    finishRace('You reached the line in ' + ordinal(calculatePlace()) + ' place.', true);
  }
}

function updatePlayer(dt, worldSpeed) {
  const targetX = LANE_X[state.lane];
  const previousX = playerRoot.position.x;
  playerRoot.position.x = damp(playerRoot.position.x, targetX, 11.5, dt);
  const lateralVelocity = (playerRoot.position.x - previousX) / Math.max(dt, 0.001);
  playerRoot.rotation.z = damp(playerRoot.rotation.z, clamp(-lateralVelocity * 0.012, -0.24, 0.24), 9, dt);
  playerRoot.rotation.y = damp(playerRoot.rotation.y, clamp(-lateralVelocity * 0.005, -0.11, 0.11), 7, dt);
  playerRoot.position.y = Math.sin(worldTime * 9) * 0.012;
  spinCarWheels(playerCar, worldSpeed * dt * 0.8);
}

function spinCarWheels(car, amount) {
  if (!car || !car.userData.wheels) return;
  car.userData.wheels.forEach(function (wheel) { wheel.rotation.x -= amount; });
}

function updateWorld(worldSpeed, dt) {
  const move = worldSpeed * dt;
  roadSegments.forEach(function (segment) {
    segment.position.z += move;
    if (segment.position.z > 30) {
      segment.position.z -= SEGMENT_COUNT * SEGMENT_LENGTH;
      const theme = THEMES[state.themeIndex];
      if (segment.userData.theme !== theme.id) populateDecor(segment, theme);
    }
  });

  const targetTheme = THEMES[state.themeIndex];
  scene.background.lerp(targetTheme.sky, 1 - Math.exp(-0.55 * dt));
  scene.fog.color.lerp(targetTheme.fog, 1 - Math.exp(-0.55 * dt));
  roadMaterial.color.lerp(targetTheme.road, 1 - Math.exp(-0.72 * dt));
  shoulderMaterial.color.lerp(targetTheme.shoulder, 1 - Math.exp(-0.72 * dt));

  if (stars) stars.rotation.y += dt * 0.002;
  if (moon) moon.position.x += Math.sin(worldTime * 0.03) * dt * 0.04;
}

function updateTraffic(worldSpeed, dt) {
  const freezeFactor = CARS[state.selectedCar].powerType === 'freeze' && state.abilityTime > 0 ? 0.43 : 1;
  let farthest = Math.min.apply(null, traffic.map(function (entry) { return entry.mesh.position.z; }));
  traffic.forEach(function (entry) {
    const relative = (1 - entry.speedFactor) * freezeFactor;
    entry.mesh.position.z += worldSpeed * relative * dt;
    entry.laneTimer -= dt;
    if (entry.laneTimer <= 0 && entry.mesh.position.z < -22) {
      entry.laneTimer = random(2.5, 6);
      if (Math.random() < 0.44) entry.targetLane = clamp(entry.lane + pick([-1, 1]), 0, 2);
    }
    entry.mesh.position.x = damp(entry.mesh.position.x, LANE_X[entry.targetLane], 2.8, dt);
    if (Math.abs(entry.mesh.position.x - LANE_X[entry.targetLane]) < 0.08) entry.lane = entry.targetLane;
    entry.mesh.rotation.z = damp(entry.mesh.rotation.z, (LANE_X[entry.targetLane] - entry.mesh.position.x) * -0.055, 4.5, dt);
    spinCarWheels(entry.mesh, worldSpeed * entry.speedFactor * dt * 0.7);

    const dz = Math.abs(entry.mesh.position.z - PLAYER_Z);
    const dx = Math.abs(entry.mesh.position.x - playerRoot.position.x);
    if (dz < 2.05 && dx < 1.34) {
      if (isProtected()) {
        burstAt(entry.mesh.position.clone().add(new THREE.Vector3(0, 0.7, 0)), CARS[state.selectedCar].accent, 18);
        resetTraffic(entry, farthest - random(25, 42));
        farthest = entry.mesh.position.z;
        state.distance += 20;
        state.shake = Math.max(state.shake, 0.2);
      } else {
        crash('You clipped traffic.');
      }
      return;
    }

    if (!entry.passed && entry.mesh.position.z > PLAYER_Z + 2.5) {
      entry.passed = true;
      if (dx > 1.34 && dx < 3.25) showNearMiss();
    }

    if (entry.mesh.position.z > 19) {
      resetTraffic(entry, farthest - random(20, 38));
      farthest = entry.mesh.position.z;
    }
  });
}

function updatePickups(worldSpeed, dt) {
  let farthest = Math.min.apply(null, pickups.map(function (entry) { return entry.mesh.position.z; }));
  const magnet = CARS[state.selectedCar].powerType === 'bloom' && state.abilityTime > 0;
  pickups.forEach(function (entry) {
    entry.mesh.position.z += worldSpeed * 0.83 * dt;
    entry.spin += dt;
    entry.mesh.rotation.y += dt * 1.8;
    entry.mesh.children[1].rotation.x += dt * 1.3;
    entry.mesh.children[2].rotation.z += dt * 1.7;
    entry.mesh.position.y = 1.08 + Math.sin(entry.spin * 2.4) * 0.14;
    if (magnet && entry.mesh.position.z > -24 && entry.mesh.position.z < PLAYER_Z) {
      entry.mesh.position.x = damp(entry.mesh.position.x, playerRoot.position.x, 5.5, dt);
    }
    if (Math.abs(entry.mesh.position.z - PLAYER_Z) < 1.8 &&
      Math.abs(entry.mesh.position.x - playerRoot.position.x) < 1.25) {
      collectPickup(entry);
      farthest = entry.mesh.position.z;
    } else if (entry.mesh.position.z > 16) {
      resetPickup(entry, farthest - random(85, 130));
      farthest = entry.mesh.position.z;
    }
  });
}

function difficultyPace(index) {
  const base = state.difficulty === 'easy' ? 0.94 : state.difficulty === 'hard' ? 1.035 : 0.988;
  return base + (index === 0 ? 0.008 : -0.006);
}

function updateRivals(dt) {
  if (state.mode !== 'rivals') return;
  rivalCars.forEach(function (rival, index) {
    const desiredSpeed = (202 + Math.min(54, state.distance * 0.017)) * difficultyPace(index);
    const wave = Math.sin(worldTime * 0.55 + rival.paceNoise) * 7;
    rival.progress += Math.max(0, desiredSpeed + wave) / 3.6 * dt;
    rival.think -= dt;
    if (rival.think <= 0) {
      rival.think = random(1.15, state.difficulty === 'hard' ? 2.1 : 3.1);
      rival.targetLane = clamp(rival.lane + pick([-1, 0, 1]), 0, 2);
    }
    rival.mesh.position.x = damp(rival.mesh.position.x, LANE_X[rival.targetLane], 3.8, dt);
    if (Math.abs(rival.mesh.position.x - LANE_X[rival.targetLane]) < 0.08) rival.lane = rival.targetLane;
    rival.mesh.position.z = PLAYER_Z - (rival.progress - state.distance) * 0.19;
    rival.mesh.visible = rival.mesh.position.z > -92 && rival.mesh.position.z < 20;
    rival.mesh.rotation.z = damp(rival.mesh.rotation.z,
      (LANE_X[rival.targetLane] - rival.mesh.position.x) * -0.045, 4, dt);
    spinCarWheels(rival.mesh, desiredSpeed * 0.14 * dt * 0.72);
  });
  const remaining = FINISH_DISTANCE - state.distance;
  finishGate.position.z = PLAYER_Z - remaining * 0.19;
  finishGate.visible = finishGate.position.z > -105 && finishGate.position.z < 22;
  state.racePlace = calculatePlace();
}

function calculatePlace() {
  if (state.mode !== 'rivals') return 1;
  let place = 1;
  rivalCars.forEach(function (rival) {
    if (rival.progress > state.distance) place += 1;
  });
  return place;
}

function ordinal(number) {
  if (number === 1) return 'first';
  if (number === 2) return 'second';
  return 'third';
}

function updateAbilities(dt) {
  const definition = CARS[state.selectedCar];
  const active = state.abilityTime > 0;
  if (abilityHalo) {
    abilityHalo.visible = active;
    abilityHalo.rotation.z += dt * 2.8;
    const pulse = 1 + Math.sin(worldTime * 8) * 0.07;
    abilityHalo.scale.setScalar(pulse);
  }
  if (shieldMesh) {
    shieldMesh.visible = state.shieldTime > 0 || (active && definition.powerType === 'bloom');
    shieldMesh.rotation.y += dt * 0.42;
    shieldMesh.material.opacity = 0.14 + Math.sin(worldTime * 5) * 0.035;
  }
  if (active) {
    playerCar.userData.paint.emissive.setHex(definition.accent);
    playerCar.userData.paint.emissiveIntensity = 0.55 + Math.sin(worldTime * 10) * 0.25;
    playerCar.userData.glow.material.opacity = 0.43 + Math.sin(worldTime * 9) * 0.09;
    if (definition.powerType === 'siren' && playerCar.userData.sirenMaterials) {
      const flip = Math.floor(worldTime * 10) % 2;
      playerCar.userData.sirenMaterials[0].emissiveIntensity = flip ? 8 : 2;
      playerCar.userData.sirenMaterials[1].emissiveIntensity = flip ? 2 : 8;
    }
  } else {
    playerCar.userData.paint.emissiveIntensity = 0;
    playerCar.userData.paint.emissive.setHex(0x000000);
    playerCar.userData.glow.material.opacity = 0.23;
  }
}

function checkTheme() {
  const index = Math.floor(state.distance / 900) % THEMES.length;
  if (index !== state.themeIndex) setTheme(index, false);
}

function burstAt(position, color, count) {
  if (REDUCED_MOTION) count = Math.min(count, 12);
  const geometry = new THREE.BufferGeometry();
  const positions = new Float32Array(count * 3);
  const velocities = [];
  for (let i = 0; i < count; i += 1) {
    positions[i * 3] = position.x;
    positions[i * 3 + 1] = position.y;
    positions[i * 3 + 2] = position.z;
    velocities.push(new THREE.Vector3(random(-4.8, 4.8), random(0.8, 6.2), random(-4.5, 4.5)));
  }
  geometry.setAttribute('position', new THREE.BufferAttribute(positions, 3));
  const material = new THREE.PointsMaterial({
    color: color,
    size: 0.18,
    transparent: true,
    opacity: 1,
    blending: THREE.AdditiveBlending,
    depthWrite: false
  });
  const points = new THREE.Points(geometry, material);
  scene.add(points);
  particleBursts.push({ points: points, velocities: velocities, age: 0, life: 0.75 });
}

function updateParticles(dt) {
  for (let i = particleBursts.length - 1; i >= 0; i -= 1) {
    const burst = particleBursts[i];
    burst.age += dt;
    const array = burst.points.geometry.attributes.position.array;
    burst.velocities.forEach(function (velocity, index) {
      velocity.y -= 7.5 * dt;
      array[index * 3] += velocity.x * dt;
      array[index * 3 + 1] += velocity.y * dt;
      array[index * 3 + 2] += velocity.z * dt;
    });
    burst.points.geometry.attributes.position.needsUpdate = true;
    burst.points.material.opacity = 1 - burst.age / burst.life;
    if (burst.age >= burst.life) {
      scene.remove(burst.points);
      burst.points.geometry.dispose();
      burst.points.material.dispose();
      particleBursts.splice(i, 1);
    }
  }
}

function updateSpeedLines(dt) {
  if (!speedLines) return;
  const active = state.phase === 'running' &&
    (state.boosting || state.itemBurst > 0 || state.abilityTime > 0 || state.speed > 250);
  speedLines.material.opacity = damp(speedLines.material.opacity, active ? 0.42 : 0, 6, dt);
  ui.speedVignette.classList.toggle('on', active);
  const velocity = Math.max(14, state.speed * 0.22);
  for (let i = 0; i < speedLinePositions.length / 6; i += 1) {
    const base = i * 6;
    speedLinePositions[base + 2] += velocity * dt;
    speedLinePositions[base + 5] += velocity * dt;
    if (speedLinePositions[base + 2] > 13) resetSpeedLine(i, false);
  }
  speedLines.geometry.attributes.position.needsUpdate = true;
}

function updateCamera(dt) {
  const portrait = window.innerHeight > window.innerWidth;
  let desired = new THREE.Vector3();
  let look = new THREE.Vector3();
  if (state.phase === 'garage') {
    desired.set(portrait ? 5.8 : 6.9, portrait ? 3.1 : 2.8, portrait ? 10.1 : 8.7);
    look.set(0, 0.84, 2.25);
    playerCar.rotation.y += dt * 0.28;
    playerRoot.position.x = damp(playerRoot.position.x, 0, 4, dt);
  } else if (state.phase === 'menu') {
    desired.set(portrait ? 0 : 2.2, portrait ? 5.25 : 4.4, portrait ? 11.6 : 10.1);
    look.set(0, 0.73, -8.8);
    playerCar.rotation.y = damp(playerCar.rotation.y, 0, 2, dt);
  } else {
    const boostOffset = state.boosting || state.abilityTime > 0 ? 0.65 : 0;
    desired.set(playerRoot.position.x * 0.07, portrait ? 5.05 : 4.3, (portrait ? 11.2 : 9.7) + boostOffset);
    look.set(playerRoot.position.x * 0.05, 0.7, portrait ? -10 : -13);
  }

  if (state.shake > 0.001) {
    desired.x += random(-0.18, 0.18) * state.shake;
    desired.y += random(-0.12, 0.12) * state.shake;
    state.shake = Math.max(0, state.shake - dt * 2.3);
  }
  camera.position.lerp(desired, 1 - Math.exp(-4.6 * dt));
  cameraTarget.lerp(look, 1 - Math.exp(-5.2 * dt));
  camera.lookAt(cameraTarget);
  const targetFov = state.phase === 'garage' ? (portrait ? 51 : 44) :
    state.phase === 'menu' ? 57 :
    (state.boosting || state.abilityTime > 0 ? 63 : 57);
  camera.fov = damp(camera.fov, targetFov, 5, dt);
  camera.updateProjectionMatrix();

  headlight.position.x = playerRoot.position.x;
  headlight.position.z = PLAYER_Z - 1.8;
  headlightTarget.position.x = playerRoot.position.x;
}

function updateMenu(dt) {
  const idleSpeed = state.phase === 'garage' ? 2.6 : 6.2;
  updateWorld(idleSpeed, dt);
  playerRoot.position.y = Math.sin(worldTime * 2.1) * 0.015;
  spinCarWheels(playerCar, idleSpeed * dt * 0.45);
}

function paintHud(force) {
  const now = performance.now();
  if (!force && now - lastHudPaint < 50) return;
  lastHudPaint = now;
  ui.distance.textContent = String(Math.floor(state.distance));
  ui.speed.textContent = String(Math.round(state.speed));
  ui.boostFill.style.transform = 'scaleX(' + state.boost.toFixed(3) + ')';
  ui.boostPercent.textContent = Math.round(state.boost * 100) + '%';
  const charge = Math.round(state.ability * 100);
  ui.abilityPercent.textContent = String(charge);
  ui.abilityButton.style.setProperty('--charge', charge + '%');
  ui.abilityButton.classList.toggle('ready', state.ability >= 0.999);
  if (state.mode === 'rivals') ui.position.textContent = state.racePlace + ' / 3';
}

function animate(frameTime) {
  const dt = Math.min(0.045, Math.max(0.001, (frameTime - lastFrame) / 1000));
  lastFrame = frameTime;
  worldTime += dt;

  if (state.phase === 'menu' || state.phase === 'garage') updateMenu(dt);
  else if (state.phase !== 'paused' && state.phase !== 'ended') updateRace(dt);

  updateParticles(dt);
  updateSpeedLines(dt);
  updateCamera(dt);
  paintHud(false);
  audioSystem.update(state.speed, state.boosting || state.abilityTime > 0);
  renderer.render(scene, camera);
}

const audioSystem = {
  context: null,
  master: null,
  engine: null,
  engineGain: null,
  engineFilter: null,
  active: false,
  unlock: function () {
    if (this.context) {
      if (this.context.state === 'suspended') this.context.resume();
      return;
    }
    try {
      const AudioContextClass = window.AudioContext || window.webkitAudioContext;
      if (!AudioContextClass) return;
      this.context = new AudioContextClass();
      this.master = this.context.createGain();
      this.master.gain.value = state.muted ? 0 : 0.42;
      this.master.connect(this.context.destination);

      this.engine = this.context.createOscillator();
      this.engine.type = 'sawtooth';
      this.engineGain = this.context.createGain();
      this.engineGain.gain.value = 0;
      this.engineFilter = this.context.createBiquadFilter();
      this.engineFilter.type = 'lowpass';
      this.engineFilter.frequency.value = 240;
      this.engine.connect(this.engineFilter);
      this.engineFilter.connect(this.engineGain);
      this.engineGain.connect(this.master);
      this.engine.start();
    } catch (error) {}
  },
  setMuted: function (muted) {
    state.muted = muted;
    safeStorageSet('redline3d.muted', muted ? '1' : '0');
    ui.soundButton.classList.toggle('muted', muted);
    ui.soundButton.setAttribute('aria-pressed', muted ? 'true' : 'false');
    ui.soundButton.setAttribute('aria-label', muted ? 'Turn sound on' : 'Mute sound');
    if (this.master && this.context) {
      this.master.gain.setTargetAtTime(muted ? 0 : 0.42, this.context.currentTime, 0.03);
    }
  },
  setEngine: function (active) {
    this.active = active;
    if (active) this.unlock();
  },
  update: function (speed, boost) {
    if (!this.context || !this.engine || !this.engineGain) return;
    const now = this.context.currentTime;
    const frequency = 44 + speed * 0.34 + (boost ? 18 : 0);
    this.engine.frequency.setTargetAtTime(frequency, now, 0.08);
    this.engineFilter.frequency.setTargetAtTime(190 + speed * 2.1, now, 0.09);
    this.engineGain.gain.setTargetAtTime(this.active && !state.muted ? 0.075 + speed / 6500 : 0, now, 0.08);
  },
  tone: function (frequency, duration, type, volume, slide) {
    this.unlock();
    if (!this.context || !this.master || state.muted) return;
    const oscillator = this.context.createOscillator();
    const gain = this.context.createGain();
    oscillator.type = type || 'sine';
    oscillator.frequency.setValueAtTime(frequency, this.context.currentTime);
    if (slide) oscillator.frequency.exponentialRampToValueAtTime(Math.max(30, slide), this.context.currentTime + duration);
    gain.gain.setValueAtTime(volume || 0.12, this.context.currentTime);
    gain.gain.exponentialRampToValueAtTime(0.0001, this.context.currentTime + duration);
    oscillator.connect(gain);
    gain.connect(this.master);
    oscillator.start();
    oscillator.stop(this.context.currentTime + duration);
  },
  tick: function () { this.tone(170, 0.06, 'square', 0.07, 110); },
  pickup: function () {
    this.tone(540, 0.16, 'sine', 0.12, 980);
    window.setTimeout(this.tone.bind(this, 900, 0.12, 'sine', 0.07, 1240), 70);
  },
  ability: function () {
    this.tone(90, 0.48, 'sawtooth', 0.16, 440);
    window.setTimeout(this.tone.bind(this, 430, 0.35, 'sine', 0.08, 980), 90);
  },
  nearMiss: function () { this.tone(760, 0.08, 'triangle', 0.07, 1050); },
  count: function (go) { this.tone(go ? 840 : 360, go ? 0.23 : 0.12, 'square', 0.1, go ? 1260 : 320); },
  crash: function () {
    this.tone(150, 0.48, 'sawtooth', 0.18, 35);
    this.tone(62, 0.6, 'square', 0.12, 28);
  }
};

function bindControls() {
  ui.menuBest.textContent = String(state.best);
  audioSystem.setMuted(state.muted);
  paintCarSelection();

  $('.mode-button').forEach(function (button) {
    button.addEventListener('click', function () {
      state.mode = button.dataset.mode;
      $('.mode-button').forEach(function (candidate) {
        const active = candidate === button;
        candidate.classList.toggle('active', active);
        candidate.setAttribute('aria-pressed', active ? 'true' : 'false');
      });
      ui.difficultyRow.classList.toggle('visible', state.mode === 'rivals');
      audioSystem.unlock();
      audioSystem.tick();
    });
  });

  $('[data-difficulty]').forEach(function (button) {
    button.addEventListener('click', function () {
      state.difficulty = button.dataset.difficulty;
      $('[data-difficulty]').forEach(function (candidate) {
        candidate.classList.toggle('active', candidate === button);
      });
      audioSystem.tick();
    });
  });

  $('#startButton').addEventListener('click', startRace);
  $('#garageButton').addEventListener('click', showGarage);
  $('#garageBack').addEventListener('click', showStart);
  $('#garageSelect').addEventListener('click', showStart);

  $('.car-card').forEach(function (button) {
    button.addEventListener('click', function () {
      replacePlayerCar(button.dataset.car);
      button.scrollIntoView({ behavior: REDUCED_MOTION ? 'auto' : 'smooth', block: 'nearest', inline: 'center' });
      audioSystem.unlock();
      audioSystem.tick();
    });
  });

  $('#pauseButton').addEventListener('click', pauseRace);
  $('#resumeButton').addEventListener('click', resumeRace);
  $('#quitButton').addEventListener('click', showStart);
  $('#againButton').addEventListener('click', startRace);
  $('#homeButton').addEventListener('click', showStart);
  $('#leftButton').addEventListener('click', function () { moveLane(-1); });
  $('#rightButton').addEventListener('click', function () { moveLane(1); });
  ui.abilityButton.addEventListener('click', fireAbility);
  ui.itemButton.addEventListener('click', useItem);
  ui.soundButton.addEventListener('click', function () {
    audioSystem.unlock();
    audioSystem.setMuted(!state.muted);
  });

  const boostOn = function (event) {
    event.preventDefault();
    if (ui.boostButton.setPointerCapture && event.pointerId !== undefined) {
      try { ui.boostButton.setPointerCapture(event.pointerId); } catch (error) {}
    }
    setBoosting(true);
  };
  const boostOff = function (event) {
    if (event) event.preventDefault();
    setBoosting(false);
  };
  ui.boostButton.addEventListener('pointerdown', boostOn);
  ui.boostButton.addEventListener('pointerup', boostOff);
  ui.boostButton.addEventListener('pointercancel', boostOff);
  ui.boostButton.addEventListener('lostpointercapture', boostOff);

  const swipe = { active: false, x: 0, y: 0 };
  ui.canvas.addEventListener('pointerdown', function (event) {
    if (state.phase !== 'running' && state.phase !== 'countdown') return;
    swipe.active = true;
    swipe.x = event.clientX;
    swipe.y = event.clientY;
    if (ui.canvas.setPointerCapture) {
      try { ui.canvas.setPointerCapture(event.pointerId); } catch (error) {}
    }
  });
  ui.canvas.addEventListener('pointerup', function (event) {
    if (!swipe.active) return;
    const dx = event.clientX - swipe.x;
    const dy = event.clientY - swipe.y;
    swipe.active = false;
    if (Math.abs(dx) > 32 && Math.abs(dx) > Math.abs(dy)) moveLane(dx > 0 ? 1 : -1);
    else if (dy < -45) {
      state.itemBurst = Math.max(state.itemBurst, 0.45);
      state.boost = Math.max(0, state.boost - 0.08);
    } else if (Math.abs(dx) < 15 && Math.abs(dy) < 15) {
      const half = window.innerWidth / 2;
      moveLane(event.clientX < half ? -1 : 1);
    }
  });
  ui.canvas.addEventListener('pointercancel', function () { swipe.active = false; });

  document.addEventListener('keydown', function (event) {
    const key = event.key.toLowerCase();
    if (key === 'arrowleft' || key === 'a') {
      event.preventDefault();
      if (!event.repeat) moveLane(-1);
    } else if (key === 'arrowright' || key === 'd') {
      event.preventDefault();
      if (!event.repeat) moveLane(1);
    } else if (key === 'arrowup' || key === 'w') {
      event.preventDefault();
      setBoosting(true);
    } else if (key === 'shift' || key === ' ') {
      event.preventDefault();
      if (!event.repeat) fireAbility();
    } else if (key === 'e') {
      event.preventDefault();
      if (!event.repeat) useItem();
    } else if (key === 'p' || key === 'escape') {
      event.preventDefault();
      if (!event.repeat) {
        if (state.phase === 'paused') resumeRace();
        else pauseRace();
      }
    } else if (key === 'enter' && state.phase === 'menu') {
      event.preventDefault();
      startRace();
    }
  });
  document.addEventListener('keyup', function (event) {
    const key = event.key.toLowerCase();
    if (key === 'arrowup' || key === 'w') setBoosting(false);
  });

  document.addEventListener('visibilitychange', function () {
    if (document.hidden && (state.phase === 'running' || state.phase === 'countdown')) pauseRace();
  });
  window.addEventListener('blur', function () {
    setBoosting(false);
  });
}

function boot() {
  try {
    if (!initRenderer()) return;
    bindControls();
    showStart();
    ui.loader.classList.add('done');
    renderer.setAnimationLoop(animate);
  } catch (error) {
    console.error(error);
    ui.loader.classList.add('failed');
    ui.loaderText.textContent = 'The 3D scene could not start on this device.';
  }
}

boot();

  </script>
</body>
