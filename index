function makeGlowTexture() {
  const canvas = document.createElement('canvas');
  canvas.width = 128;
  canvas.height = 128;
  const context = canvas.getContext('2d');
  const gradient = context.createRadialGradient(64, 64, 4, 64, 64, 62);
  gradient.addColorStop(0, 'rgba(255,255,255,0.95)');
  gradient.addColorStop(0.28, 'rgba(255,255,255,0.55)');
  gradient.addColorStop(1, 'rgba(255,255,255,0)');
  context.fillStyle = gradient;
  context.fillRect(0, 0, 128, 128);
  const texture = new THREE.CanvasTexture(canvas);
  texture.colorSpace = THREE.SRGBColorSpace;
  return texture;
}

function makeSignTexture(text, color) {
  const canvas = document.createElement('canvas');
  canvas.width = 512;
  canvas.height = 160;
  const context = canvas.getContext('2d');
  context.fillStyle = '#090b10';
  context.fillRect(0, 0, canvas.width, canvas.height);
  context.strokeStyle = color;
  context.lineWidth = 10;
  context.strokeRect(12, 12, canvas.width - 24, canvas.height - 24);
  context.fillStyle = '#ffffff';
  context.font = '900 72px Arial Narrow, Arial, sans-serif';
  context.textAlign = 'center';
  context.textBaseline = 'middle';
  context.fillText(text, canvas.width / 2, canvas.height / 2 + 3);
  const texture = new THREE.CanvasTexture(canvas);
  texture.colorSpace = THREE.SRGBColorSpace;
  texture.anisotropy = Math.min(4, renderer.capabilities.getMaxAnisotropy());
  return texture;
}

function makeFinishTexture() {
  const canvas = document.createElement('canvas');
  canvas.width = 1024;
  canvas.height = 192;
  const context = canvas.getContext('2d');
  const cell = 32;
  for (let y = 0; y < canvas.height; y += cell) {
    for (let x = 0; x < canvas.width; x += cell) {
      context.fillStyle = ((x / cell + y / cell) % 2) ? '#08090b' : '#f5f5f7';
      context.fillRect(x, y, cell, cell);
    }
  }
  context.fillStyle = 'rgba(8,9,11,.88)';
  context.fillRect(270, 16, 484, 160);
  context.strokeStyle = '#f0272f';
  context.lineWidth = 8;
  context.strokeRect(270, 16, 484, 160);
  context.fillStyle = '#ffffff';
  context.font = '900 86px Arial Narrow, Arial, sans-serif';
  context.textAlign = 'center';
  context.textBaseline = 'middle';
  context.fillText('FINISH', 512, 101);
  const texture = new THREE.CanvasTexture(canvas);
  texture.colorSpace = THREE.SRGBColorSpace;
  texture.anisotropy = Math.min(4, renderer.capabilities.getMaxAnisotropy());
  return texture;
}

function createSky() {
  const starCount = LOW_POWER ? 260 : 520;
  const positions = new Float32Array(starCount * 3);
  for (let i = 0; i < starCount; i += 1) {
    const radius = random(120, 260);
    const angle = random(0, Math.PI * 2);
    positions[i * 3] = Math.cos(angle) * radius;
    positions[i * 3 + 1] = random(18, 105);
    positions[i * 3 + 2] = Math.sin(angle) * radius - 70;
  }
  const geometry = new THREE.BufferGeometry();
  geometry.setAttribute('position', new THREE.BufferAttribute(positions, 3));
  const material = new THREE.PointsMaterial({
    color: 0xdce9ff,
    size: LOW_POWER ? 0.42 : 0.55,
    sizeAttenuation: true,
    transparent: true,
    opacity: 0.78,
    depthWrite: false
  });
  stars = new THREE.Points(geometry, material);
  scene.add(stars);

  const moonMaterial = new THREE.MeshBasicMaterial({ color: 0xdde9ff, fog: false });
  moon = new THREE.Mesh(new THREE.SphereGeometry(4.4, 40, 24), moonMaterial);
  moon.position.set(-45, 48, -150);
  scene.add(moon);

  const moonGlow = new THREE.Sprite(new THREE.SpriteMaterial({
    map: glowTexture,
    color: 0x8bbdff,
    transparent: true,
    opacity: 0.25,
    blending: THREE.AdditiveBlending,
    depthWrite: false,
    fog: false
  }));
  moonGlow.scale.set(22, 22, 1);
  moon.add(moonGlow);
}

