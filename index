  const decor = new THREE.Group();
  decor.name = 'decor';
  group.add(decor);
  populateDecor(group, THEMES[0]);
  return group;
}

function materialFor(key, options) {
  if (!materialCache[key]) materialCache[key] = new THREE.MeshStandardMaterial(options);
  return materialCache[key];
}

function physicalMaterialFor(key, options) {
  if (!materialCache[key]) materialCache[key] = new THREE.MeshPhysicalMaterial(options);
  return materialCache[key];
}

function clearGroup(group) {
  while (group.children.length) group.remove(group.children[group.children.length - 1]);
}

function populateDecor(segment, theme) {
  const root = segment.getObjectByName('decor');
  clearGroup(root);
  segment.userData.theme = theme.id;
  const index = segment.userData.index;

  [-1, 1].forEach(function (side) {
    const lamp = makeLamp(side, theme);
    lamp.position.z = index % 2 === 0 ? -9 : 10;
    root.add(lamp);

    if (theme.id === 'city') {
      const buildingA = makeBuilding(side, random(7, 13), random(4.2, 6.5), theme, index);
      buildingA.position.z = random(-10, 8);
      root.add(buildingA);
      if (index % 3 === 0) {
        const buildingB = makeBuilding(side, random(4.5, 8.5), random(3.6, 5.2), theme, index + 7);
        buildingB.position.z = side > 0 ? -13 : 12;
        root.add(buildingB);
      }
      if ((index + (side > 0 ? 1 : 0)) % 5 === 0) root.add(makeBillboard(side, theme));
    } else {
      const rocks = makeRocks(side, index);
      rocks.position.z = random(-10, 10);
      root.add(rocks);
      if (index % 4 === 0) root.add(makeBillboard(side, theme));
    }
  });
}

function makeLamp(side, theme) {
  const group = new THREE.Group();
  const poleMaterial = materialFor('pole', {
    color: 0x272c33,
    metalness: 0.82,
    roughness: 0.28
  });
  const lampMaterial = materialFor('lamp-' + theme.id, {
    color: theme.light,
    emissive: theme.light,
    emissiveIntensity: 5,
    toneMapped: false
  });
  const pole = new THREE.Mesh(shared.pole, poleMaterial);
  pole.position.set(side * 7.12, 2.15, 0);
  group.add(pole);
  const arm = new THREE.Mesh(shared.bar, poleMaterial);
  arm.scale.y = 1.25;
  arm.rotation.z = Math.PI / 2;
  arm.position.set(side * 6.55, 4.27, 0);
  group.add(arm);
  const light = new THREE.Mesh(shared.lamp, lampMaterial);
  light.position.set(side * 6.0, 4.23, 0);
  group.add(light);
  return group;
}

