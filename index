  });

  [-6.55, 6.55].forEach(function (x) {
    const curb = new THREE.Mesh(shared.curb, curbMaterial);
    curb.position.set(x, 0, 0);
    curb.receiveShadow = true;
    group.add(curb);
  });

  [-1.6, 1.6].forEach(function (x) {
    for (let z = -15; z <= 15; z += 7.2) {
      const dash = new THREE.Mesh(shared.dash, laneMaterial);
