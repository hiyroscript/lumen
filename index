const lerp = function (a, b, amount) { return a + (b - a) * amount; };
const damp = function (a, b, lambda, dt) { return lerp(a, b, 1 - Math.exp(-lambda * dt)); };
const random = function (min, max) { return min + Math.random() * (max - min); };
const pick = function (values) { return values[Math.floor(Math.random() * values.length)]; };

