  const facadeColor = pick([0x111722, 0x161d29, 0x202431, 0x141820]);
  const facade = new THREE.Mesh(shared.unitBox, physicalMaterialFor('building-' + facadeColor, {
    color: facadeColor,
    metalness: 0.38,
    roughness: 0.43,
