<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no,viewport-fit=cover">
  <meta name="theme-color" content="#08090b">
  <meta name="description" content="REDLINE 3D — a fast, mobile-first three-lane road racer.">
  <title>REDLINE 3D</title>
  <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=IBM+Plex+Mono:wght@500;600&family=Inter:wght@500;600;700;800&display=swap" rel="stylesheet">
  <style>
:root {
  color-scheme: dark;
  --red: #f0272f;
  --red-deep: #9d1018;
  --ink: #08090b;
  --ink-soft: #111318;
  --paper: #f5f5f7;
  --muted: #9da2ac;
  --line: rgba(255, 255, 255, .16);
  --glass: rgba(12, 14, 18, .68);
  --safe-top: env(safe-area-inset-top, 0px);
  --safe-bottom: env(safe-area-inset-bottom, 0px);
  --safe-left: env(safe-area-inset-left, 0px);
  --safe-right: env(safe-area-inset-right, 0px);
  --display: "Archivo Black", Impact, "Arial Narrow", sans-serif;
  --body: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  --mono: "IBM Plex Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
}

* {
  box-sizing: border-box;
  -webkit-tap-highlight-color: transparent;
}

html,
body {
  width: 100%;
  height: 100%;
  margin: 0;
  overflow: hidden;
  background: var(--ink);
}

body {
  color: var(--paper);
  font-family: var(--body);
  font-size: 16px;
  overscroll-behavior: none;
  -webkit-user-select: none;
  user-select: none;
  touch-action: none;
}

button {
  color: inherit;
  font: inherit;
}

button:focus-visible {
  outline: 3px solid #fff;
  outline-offset: 3px;
}

svg {
  width: 24px;
  height: 24px;
  fill: none;
  stroke: currentColor;
  stroke-linecap: round;
  stroke-linejoin: round;
  stroke-width: 2;
}

#app {
  position: fixed;
  inset: 0;
  width: 100%;
  height: 100%;
  height: 100dvh;
  overflow: hidden;
  isolation: isolate;
  background: radial-gradient(circle at 50% 22%, #242933, #08090b 68%);
}

#gameCanvas {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  display: block;
  touch-action: none;
}

#speedVignette {
  position: absolute;
  inset: 0;
  z-index: 2;
  opacity: 0;
  pointer-events: none;
  background:
    radial-gradient(ellipse at center, transparent 28%, rgba(255, 20, 28, .04) 57%, rgba(3, 4, 7, .7) 110%),
    repeating-conic-gradient(from 0deg at 50% 70%, rgba(255,255,255,.13) 0 .12deg, transparent .12deg 7deg);
  mix-blend-mode: screen;
  transition: opacity .18s ease;
  mask-image: radial-gradient(ellipse at center, transparent 0 34%, #000 72%);
  -webkit-mask-image: radial-gradient(ellipse at center, transparent 0 34%, #000 72%);
}

#speedVignette.on {
  opacity: .42;
  animation: rush .32s linear infinite;
}

@keyframes rush {
  to { transform: scale(1.04) rotate(.25deg); }
}

#impactFlash {
  position: absolute;
  inset: 0;
  z-index: 42;
  pointer-events: none;
  background: #fff;
  opacity: 0;
}

#impactFlash.hit {
  animation: impact .52s ease-out;
}

@keyframes impact {
  0% { opacity: .94; background: #fff; }
  18% { opacity: .72; background: var(--red); }
  100% { opacity: 0; background: var(--red); }
}

.loader {
  position: absolute;
  inset: 0;
  z-index: 100;
  display: grid;
  place-content: center;
  gap: 20px;
  text-align: center;
  background: #08090b;
  transition: opacity .55s ease, visibility .55s ease;
}

.loader.done {
  opacity: 0;
  visibility: hidden;
  pointer-events: none;
}

.loader p {
  margin: 0;
  color: #a7abb4;
  font-family: var(--mono);
  font-size: 12px;
  letter-spacing: .13em;
  text-transform: uppercase;
}

.loader.failed p {
  max-width: 330px;
  padding: 0 24px;
  color: #fff;
  letter-spacing: .04em;
  line-height: 1.6;
  text-transform: none;
}

.loader-mark {
  display: flex;
  justify-content: center;
  gap: 8px;
}

.loader-mark i {
  display: block;
  width: 10px;
  height: 34px;
  border-radius: 8px;
  background: var(--red);
  animation: load-bar .9s ease-in-out infinite alternate;
}

.loader-mark i:nth-child(2) { animation-delay: .16s; }
.loader-mark i:nth-child(3) { animation-delay: .32s; }

@keyframes load-bar {
  from { transform: scaleY(.45); opacity: .35; }
  to { transform: scaleY(1); opacity: 1; }
}

.screen {
  position: absolute;
  inset: 0;
  z-index: 5;
  opacity: 0;
  visibility: hidden;
  pointer-events: none;
  transition: opacity .35s ease, visibility .35s ease;
}

.screen.active {
  opacity: 1;
  visibility: visible;
  pointer-events: auto;
}

.screen::before {
  content: "";
  position: absolute;
  inset: 0;
  z-index: -1;
  pointer-events: none;
}

.start-screen {
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  padding:
    calc(18px + var(--safe-top))
    calc(18px + var(--safe-right))
    calc(18px + var(--safe-bottom))
    calc(18px + var(--safe-left));
}

.start-screen::before {
  background:
    linear-gradient(180deg, rgba(4,5,8,.78) 0%, rgba(4,5,8,.1) 27%, rgba(4,5,8,.08) 48%, rgba(4,5,8,.88) 100%),
    linear-gradient(90deg, rgba(4,5,8,.32), transparent 35%, transparent 65%, rgba(4,5,8,.32));
}

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.glass,
.glass-panel,
.dark-glass {
  border: 1px solid rgba(255,255,255,.16);
  background: var(--glass);
  box-shadow: 0 18px 50px rgba(0,0,0,.24), inset 0 1px rgba(255,255,255,.08);
  backdrop-filter: blur(18px) saturate(125%);
  -webkit-backdrop-filter: blur(18px) saturate(125%);
}

.dark-glass {
  background: rgba(7, 9, 12, .72);
}

.round-button {
  appearance: none;
  width: 48px;
  height: 48px;
  padding: 0;
  display: grid;
  place-items: center;
  border-radius: 15px;
  cursor: pointer;
}

.sound-off { display: none; }
.muted .sound-on { display: none; }
.muted .sound-off { display: block; }

.best-chip {
  min-height: 48px;
  padding: 7px 13px 7px 15px;
  display: flex;
  align-items: center;
  gap: 12px;
  border-radius: 15px;
}

.best-chip > span {
  color: #a8adb8;
  font-family: var(--mono);
  font-size: 12px;
  letter-spacing: .14em;
}

.best-chip strong {
  font-family: var(--mono);
  font-size: 15px;
  font-weight: 600;
}

.best-chip b { color: #fff; }

.hero {
  position: absolute;
  left: calc(20px + var(--safe-left));
  top: max(96px, calc(74px + var(--safe-top)));
  max-width: 600px;
  text-shadow: 0 3px 28px rgba(0,0,0,.65);
  pointer-events: none;
}

.kicker {
  margin: 0 0 10px;
  color: #c9cdd4;
  font-family: var(--mono);
  font-size: 12px;
  font-weight: 600;
  letter-spacing: .18em;
}

.hero h1 {
  margin: 0;
  font-family: var(--display);
  font-size: clamp(45px, 14vw, 96px);
  font-weight: 900;
  letter-spacing: -.065em;
  line-height: .82;
}

.hero h1 span { color: var(--red); }

.hero h1 sup {
  display: inline-block;
  margin-left: 8px;
  color: #fff;
  font-family: var(--mono);
  font-size: .19em;
  letter-spacing: .12em;
  vertical-align: top;
  transform: translateY(-.15em);
}

.hero-note {
  max-width: 380px;
  margin: 16px 0 0;
  color: rgba(255,255,255,.72);
  font-size: 14px;
  font-weight: 600;
  line-height: 1.4;
}

.start-dock {
  position: relative;
  width: min(100%, 510px);
  margin: auto auto 0;
  padding: 14px;
  border-radius: 24px;
}

.mode-switch {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 8px;
}

.mode-button {
  appearance: none;
  min-width: 0;
  min-height: 66px;
  padding: 10px;
  display: flex;
  align-items: center;
  gap: 9px;
  text-align: left;
  border: 1px solid rgba(255,255,255,.08);
  border-radius: 15px;
  background: rgba(255,255,255,.055);
  cursor: pointer;
  transition: background .2s ease, border-color .2s ease, transform .14s ease;
}

.mode-button:active { transform: scale(.975); }

.mode-button.active {
  border-color: rgba(240,39,47,.72);
  background: rgba(240,39,47,.16);
}

.mode-button > span:last-child {
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.mode-button b {
  font-family: var(--display);
  font-size: 13px;
  letter-spacing: -.01em;
  text-transform: uppercase;
}

.mode-button small {
  margin-top: 3px;
  overflow: hidden;
  color: #9da2ad;
  font-size: 12px;
  line-height: 1.15;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.mode-icon {
  width: 34px;
  height: 34px;
  flex: 0 0 34px;
  display: grid;
  place-items: center;
  color: #fff;
  border-radius: 11px;
  background: #24272d;
}

.mode-button.active .mode-icon {
  background: var(--red);
  box-shadow: 0 7px 18px rgba(240,39,47,.3);
}

.mode-icon.infinity {
  padding-bottom: 3px;
  font-family: var(--display);
  font-size: 25px;
}

.mode-icon svg {
  width: 19px;
  height: 19px;
}

.difficulty-row {
  max-height: 0;
  margin: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  overflow: hidden;
  opacity: 0;
  transition: max-height .25s ease, margin .25s ease, opacity .25s ease;
}

.difficulty-row.visible {
  max-height: 52px;
  margin: 11px 2px 0;
  opacity: 1;
}

.difficulty-row > span {
  color: #9197a1;
  font-family: var(--mono);
  font-size: 12px;
  letter-spacing: .12em;
}

.difficulty-row > div {
  display: flex;
  gap: 4px;
  padding: 3px;
  border-radius: 10px;
  background: rgba(255,255,255,.07);
}

.difficulty-row button {
  appearance: none;
  min-height: 32px;
  padding: 0 10px;
  color: #a7abb4;
  font-size: 12px;
  font-weight: 700;
  border: 0;
  border-radius: 8px;
  background: transparent;
}

.difficulty-row button.active {
  color: #fff;
  background: rgba(255,255,255,.14);
}

.car-picker {
  appearance: none;
  width: 100%;
  min-height: 58px;
  margin: 11px 0 10px;
  padding: 8px 12px;
  display: flex;
  align-items: center;
  gap: 11px;
  border: 1px solid rgba(255,255,255,.12);
  border-radius: 15px;
  background: rgba(255,255,255,.06);
  cursor: pointer;
}

.car-picker:active { background: rgba(255,255,255,.1); }

.car-swatch {
  width: 40px;
  height: 40px;
  flex: 0 0 40px;
  border: 1px solid rgba(255,255,255,.24);
  border-radius: 12px;
  background: var(--red);
  box-shadow: inset 0 1px rgba(255,255,255,.35), 0 8px 18px rgba(0,0,0,.22);
}

.car-picker > span:nth-child(2) {
  min-width: 0;
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: flex-start;
}

.car-picker small {
  color: #8f949f;
  font-family: var(--mono);
  font-size: 12px;
  letter-spacing: .12em;
}

.car-picker b {
  font-family: var(--display);
  font-size: 17px;
  letter-spacing: .02em;
}

.power-pill {
  padding: 6px 8px;
  color: #ffc5c8;
  font-family: var(--mono);
  font-size: 12px;
  letter-spacing: .06em;
  border-radius: 8px;
  background: rgba(240,39,47,.14);
}

.car-picker > svg {
  width: 18px;
  color: #777d88;
}

.primary-button,
.secondary-button {
  appearance: none;
  width: 100%;
  min-height: 58px;
  padding: 0 20px;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12px;
  font-family: var(--display);
  font-size: 17px;
  letter-spacing: .025em;
  border-radius: 15px;
  cursor: pointer;
  transition: transform .12s ease, background .15s ease, box-shadow .15s ease;
}

.primary-button {
  color: #fff;
  border: 1px solid #ff555c;
  background: linear-gradient(180deg, #f1323a, #ce151e);
  box-shadow: 0 8px 0 #820d13, 0 14px 30px rgba(240,39,47,.25), inset 0 1px rgba(255,255,255,.25);
}

.primary-button:active {
  transform: translateY(5px);
  box-shadow: 0 3px 0 #820d13, 0 8px 20px rgba(240,39,47,.22);
}

.primary-button svg { width: 22px; }

.secondary-button {
  margin-top: 12px;
  color: #d8dae0;
  border: 1px solid rgba(255,255,255,.18);
  background: rgba(255,255,255,.065);
}

.secondary-button:active { transform: scale(.98); background: rgba(255,255,255,.12); }

.control-hint {
  margin: 14px 4px 0;
  color: #8e939e;
  font-size: 12px;
  font-weight: 600;
  line-height: 1.3;
  text-align: center;
}

.control-hint span { color: #fff; }

.garage-screen {
  display: flex;
  flex-direction: column;
  padding:
    calc(18px + var(--safe-top))
    calc(18px + var(--safe-right))
    calc(18px + var(--safe-bottom))
    calc(18px + var(--safe-left));
}

.garage-screen::before {
  background:
    linear-gradient(180deg, rgba(5,6,8,.82), rgba(5,6,8,.06) 25%, rgba(5,6,8,.06) 53%, rgba(5,6,8,.94) 82%),
    radial-gradient(circle at 50% 42%, transparent 22%, rgba(4,5,7,.42) 88%);
}

.garage-head {
  display: flex;
  align-items: center;
  gap: 14px;
}

.garage-head .kicker { margin: 0 0 3px; color: #a4a9b3; }

.garage-head h2 {
  margin: 0;
  font-family: var(--display);
  font-size: clamp(24px, 7vw, 36px);
  line-height: 1;
  text-transform: uppercase;
}

.garage-copy {
  width: min(100%, 540px);
  margin: auto auto 160px;
  padding: 14px 16px;
  display: grid;
  grid-template-columns: .8fr 1.4fr;
  gap: 16px;
  border-radius: 18px;
}

.garage-copy > div:first-child {
  padding-right: 14px;
  border-right: 1px solid rgba(255,255,255,.13);
}

.garage-copy > div:first-child > span {
  color: var(--red);
  font-family: var(--mono);
  font-size: 12px;
  font-weight: 600;
}

.garage-copy h3 {
  margin: 5px 0 3px;
  font-family: var(--display);
  font-size: clamp(22px, 6vw, 31px);
  line-height: .95;
}

.garage-copy p {
  margin: 0;
  color: #a5aab4;
  font-size: 12px;
  line-height: 1.4;
}

.ability-copy {
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.ability-copy small {
  color: #858b96;
  font-family: var(--mono);
  font-size: 12px;
  letter-spacing: .12em;
}

.ability-copy b {
  margin: 4px 0 3px;
  color: #fff;
  font-family: var(--display);
  font-size: 15px;
  letter-spacing: .04em;
}

.car-rail {
  position: absolute;
  right: 0;
  bottom: calc(92px + var(--safe-bottom));
  left: 0;
  padding: 10px max(18px, calc((100vw - 620px) / 2));
  display: flex;
  gap: 9px;
  overflow-x: auto;
  scroll-snap-type: x mandatory;
  scrollbar-width: none;
}

.car-rail::-webkit-scrollbar { display: none; }

.car-card {
  appearance: none;
  min-width: 108px;
  height: 73px;
  padding: 8px 9px;
  display: grid;
  grid-template-columns: 14px 1fr;
  grid-template-rows: 1fr 1fr;
  align-items: center;
  gap: 0 8px;
  text-align: left;
  border: 1px solid rgba(255,255,255,.13);
  border-radius: 14px;
  background: rgba(10,12,15,.75);
  box-shadow: inset 0 1px rgba(255,255,255,.06);
  backdrop-filter: blur(15px);
  -webkit-backdrop-filter: blur(15px);
  scroll-snap-align: center;
  cursor: pointer;
  transition: border-color .18s ease, background .18s ease, transform .15s ease;
}

.car-card:active { transform: scale(.97); }

.car-card.active {
  border-color: var(--red);
  background: rgba(240,39,47,.15);
}

.car-card i {
  grid-row: 1 / 3;
  width: 11px;
  height: 42px;
  border-radius: 7px;
  background: var(--car);
  box-shadow: 0 0 16px color-mix(in srgb, var(--car) 55%, transparent);
}

.car-card span {
  align-self: end;
  font-family: var(--display);
  font-size: 12px;
}

.car-card small {
  align-self: start;
  margin-top: 2px;
  color: #8f949f;
  font-family: var(--mono);
  font-size: 12px;
}

.garage-select {
  position: absolute;
  right: max(18px, calc((100vw - 510px) / 2));
  bottom: calc(17px + var(--safe-bottom));
  left: max(18px, calc((100vw - 510px) / 2));
  width: auto;
}

.hud {
  position: absolute;
  inset: 0;
  z-index: 10;
  padding:
    calc(14px + var(--safe-top))
    calc(14px + var(--safe-right))
    calc(14px + var(--safe-bottom))
    calc(14px + var(--safe-left));
  opacity: 0;
  visibility: hidden;
  pointer-events: none;
  transition: opacity .25s ease;
}

.hud.active {
  opacity: 1;
  visibility: visible;
}

.hud button { pointer-events: auto; }

.hud-top {
  display: grid;
  grid-template-columns: 48px 1fr auto;
  align-items: start;
  gap: 9px;
}

.distance-card,
.speed-card,
.district-chip,
.item-button,
.boost-meter {
  border-radius: 15px;
}

.distance-card {
  position: relative;
  min-height: 61px;
  padding: 8px 14px 7px;
}

.distance-card small,
.speed-card small,
.result-stats small {
  display: block;
  color: #9298a3;
  font-family: var(--mono);
  font-size: 12px;
  letter-spacing: .12em;
}

.distance-card strong {
  display: block;
  font-family: var(--mono);
  font-size: 24px;
  line-height: 1.15;
}

.distance-card em {
  margin-left: 4px;
  color: #9fa4ae;
  font-size: 12px;
  font-style: normal;
}

.position-value {
  position: absolute;
  right: 11px;
  bottom: 9px;
  display: none;
  color: #ffd455;
  font-family: var(--mono);
  font-size: 12px;
  font-weight: 600;
}

.position-value.visible { display: block; }

.speed-card {
  min-width: 72px;
  min-height: 61px;
  padding: 8px 10px 7px;
  text-align: right;
}

.speed-card strong {
  display: block;
  font-family: var(--mono);
  font-size: 19px;
  line-height: 1.1;
}

.speed-card > span {
  color: #747a85;
  font-family: var(--mono);
  font-size: 12px;
}

.district-chip {
  width: max-content;
  max-width: calc(100vw - 28px);
  margin: 10px auto 0;
  padding: 8px 12px;
  display: flex;
  align-items: center;
  gap: 8px;
  color: #d7d9de;
  font-family: var(--mono);
  font-size: 12px;
  letter-spacing: .1em;
}

.district-chip i {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: #61d4ff;
  box-shadow: 0 0 10px #61d4ff;
}

.combo-chip {
  width: max-content;
  margin: 12px auto;
  padding: 7px 12px;
  color: #fff;
  font-family: var(--display);
  font-size: 12px;
  letter-spacing: .05em;
  border: 1px solid rgba(255,255,255,.2);
  border-radius: 10px;
  background: rgba(7,8,11,.72);
  opacity: 0;
  transform: translateY(-8px) scale(.94);
  transition: opacity .18s ease, transform .18s ease;
}

.combo-chip b { color: #ffd350; }

.combo-chip.show {
  opacity: 1;
  transform: none;
}

.hud-bottom {
  position: absolute;
  right: calc(14px + var(--safe-right));
  bottom: calc(18px + var(--safe-bottom));
  left: calc(14px + var(--safe-left));
  display: grid;
  grid-template-columns: 58px 1fr 64px;
  align-items: end;
  gap: 10px;
}

.item-button {
  appearance: none;
  width: 58px;
  height: 58px;
  padding: 4px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 1px solid rgba(255,255,255,.16);
}

.item-button:disabled { opacity: .45; }

.item-button > span {
  font-family: var(--display);
  font-size: 19px;
}

.item-button small {
  max-width: 50px;
  overflow: hidden;
  color: #9298a3;
  font-family: var(--mono);
  font-size: 12px;
  line-height: 1;
  text-overflow: ellipsis;
}

.boost-meter {
  min-height: 52px;
  padding: 9px 12px;
}

.meter-label {
  margin-bottom: 8px;
  display: flex;
  justify-content: space-between;
  color: #c8cbd1;
  font-family: var(--mono);
  font-size: 12px;
  letter-spacing: .1em;
}

.meter-label b {
  color: #fff;
  letter-spacing: 0;
}

.meter-track {
  height: 8px;
  overflow: hidden;
  border-radius: 7px;
  background: rgba(255,255,255,.1);
}

.meter-track i {
  display: block;
  width: 100%;
  height: 100%;
  border-radius: inherit;
  background: linear-gradient(90deg, #ff9f35, #ff2e38);
  box-shadow: 0 0 16px rgba(255,56,63,.55);
  transform-origin: left;
}

.ability-button {
  --charge: 25%;
  position: relative;
  appearance: none;
  width: 64px;
  height: 64px;
  padding: 0;
  display: grid;
  place-items: center;
  border: 0;
  border-radius: 50%;
  background: transparent;
}

.ability-ring {
  position: absolute;
  inset: 0;
  border-radius: inherit;
  background: conic-gradient(var(--red) var(--charge), rgba(255,255,255,.13) 0);
  box-shadow: 0 8px 24px rgba(0,0,0,.35);
}

.ability-ring::after {
  content: "";
  position: absolute;
  inset: 5px;
  border-radius: inherit;
  background: #101217;
}

.ability-inner {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.ability-inner small {
  color: #8f959f;
  font-family: var(--mono);
  font-size: 12px;
  line-height: 1;
}

.ability-inner b {
  margin-top: 2px;
  font-family: var(--mono);
  font-size: 15px;
}

.ability-button.ready .ability-ring {
  animation: ability-ready 1.1s ease-in-out infinite alternate;
}

@keyframes ability-ready {
  to { box-shadow: 0 0 25px rgba(240,39,47,.8), 0 8px 24px rgba(0,0,0,.3); }
}

.touch-controls {
  position: absolute;
  inset: 0;
  z-index: 9;
  opacity: 0;
  visibility: hidden;
  pointer-events: none;
}

.touch-controls.active {
  opacity: 1;
  visibility: visible;
}

.touch-controls button {
  pointer-events: auto;
}

.steer-button,
.boost-button {
  appearance: none;
  position: absolute;
  border: 1px solid rgba(255,255,255,.14);
  background: rgba(8,10,13,.34);
  box-shadow: inset 0 1px rgba(255,255,255,.08);
  backdrop-filter: blur(7px);
  -webkit-backdrop-filter: blur(7px);
}

.steer-button {
  bottom: calc(92px + var(--safe-bottom));
  width: 58px;
  height: 58px;
  display: grid;
  place-items: center;
  border-radius: 18px;
}

#leftButton { left: calc(14px + var(--safe-left)); }
#rightButton { left: calc(82px + var(--safe-left)); }

.steer-button:active {
  border-color: rgba(255,255,255,.55);
  background: rgba(255,255,255,.17);
  transform: scale(.94);
}

.boost-button {
  right: calc(14px + var(--safe-right));
  bottom: calc(92px + var(--safe-bottom));
  width: 90px;
  height: 58px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-color: rgba(240,39,47,.52);
  border-radius: 18px;
  background: rgba(179,15,23,.42);
}

.boost-button span {
  font-family: var(--display);
  font-size: 14px;
}

.boost-button small {
  color: rgba(255,255,255,.57);
  font-family: var(--mono);
  font-size: 12px;
}

.boost-button.held {
  background: rgba(240,39,47,.8);
  box-shadow: 0 0 25px rgba(240,39,47,.3), inset 0 1px rgba(255,255,255,.25);
  transform: scale(.96);
}

.countdown {
  position: absolute;
  inset: 0;
  z-index: 25;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 24px;
  visibility: hidden;
  pointer-events: none;
  background: rgba(4,5,7,.28);
}

.countdown.active { visibility: visible; }

.countdown strong {
  font-family: var(--display);
  font-size: clamp(92px, 30vw, 180px);
  line-height: .8;
  text-shadow: 0 16px 60px rgba(0,0,0,.65);
}

.countdown strong.pop { animation: count-pop .72s cubic-bezier(.2,.85,.2,1); }

@keyframes count-pop {
  from { opacity: 0; transform: scale(1.45); }
  to { opacity: 1; transform: scale(1); }
}

.start-lights {
  padding: 10px;
  display: flex;
  gap: 8px;
  border: 1px solid rgba(255,255,255,.14);
  border-radius: 18px;
  background: rgba(6,7,9,.82);
}

.start-lights i {
  width: 28px;
  height: 28px;
  border: 4px solid #1b1e23;
  border-radius: 50%;
  background: #2b2e34;
}

.start-lights i.lit {
  background: var(--red);
  box-shadow: 0 0 20px rgba(240,39,47,.82);
}

.start-lights i.go {
  background: #28d975;
  box-shadow: 0 0 20px rgba(40,217,117,.75);
}

.modal-layer {
  position: absolute;
  inset: 0;
  z-index: 50;
  padding: calc(18px + var(--safe-top)) 18px calc(18px + var(--safe-bottom));
  display: grid;
  place-items: center;
  opacity: 0;
  visibility: hidden;
  pointer-events: none;
  background: rgba(4,5,7,.66);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  transition: opacity .22s ease, visibility .22s ease;
}

.modal-layer.active {
  opacity: 1;
  visibility: visible;
  pointer-events: auto;
}

.modal {
  width: min(100%, 430px);
  padding: 25px;
  border-radius: 24px;
  transform: translateY(18px) scale(.98);
  transition: transform .3s cubic-bezier(.2,.85,.2,1);
}

.modal-layer.active .modal { transform: none; }

.modal h2 {
  margin: 0;
  font-family: var(--display);
  font-size: clamp(38px, 12vw, 57px);
  line-height: .92;
  text-transform: uppercase;
}

.modal > p:not(.kicker):not(.new-best) {
  margin: 14px 0 23px;
  color: #a7abb4;
  line-height: 1.5;
}

.result-stats {
  margin: 21px 0;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 8px;
}

.result-stats > div {
  min-width: 0;
  padding: 12px 10px;
  border: 1px solid rgba(255,255,255,.09);
  border-radius: 13px;
  background: rgba(255,255,255,.05);
}

.result-stats strong {
  display: block;
  margin-top: 6px;
  font-family: var(--mono);
  font-size: 15px;
  white-space: nowrap;
}

.new-best {
  width: max-content;
  margin: -6px 0 18px !important;
  padding: 7px 10px;
  color: #101114 !important;
  font-family: var(--mono);
  font-size: 12px;
  font-weight: 700;
  letter-spacing: .08em;
  border-radius: 8px;
  background: #ffd24b;
  display: none;
}

.new-best.show { display: block; }

.toast {
  position: absolute;
  top: calc(96px + var(--safe-top));
  left: 50%;
  z-index: 70;
  max-width: min(90vw, 380px);
  padding: 10px 14px;
  color: #fff;
  font-family: var(--mono);
  font-size: 12px;
  font-weight: 600;
  letter-spacing: .05em;
  text-align: center;
  border: 1px solid rgba(255,255,255,.18);
  border-radius: 12px;
  background: rgba(8,10,13,.84);
  box-shadow: 0 12px 30px rgba(0,0,0,.28);
  opacity: 0;
  pointer-events: none;
  transform: translate(-50%, -12px);
  transition: opacity .2s ease, transform .2s ease;
}

.toast.show {
  opacity: 1;
  transform: translate(-50%, 0);
}

.rotate-hint {
  position: absolute;
  right: 16px;
  bottom: 16px;
  left: 16px;
  z-index: 80;
  display: none;
  padding: 10px 14px;
  color: #d7d9df;
  font-family: var(--mono);
  font-size: 12px;
  text-align: center;
  border: 1px solid rgba(255,255,255,.14);
  border-radius: 12px;
  background: rgba(7,8,10,.84);
}

@media (min-width: 760px) {
  .start-screen {
    padding-right: 32px;
    padding-left: 32px;
  }

  .hero {
    left: 7vw;
    top: 22%;
    max-width: 510px;
  }

  .start-dock {
    margin: auto 2vw 2vh auto;
  }

  .garage-copy {
    margin-right: 4vw;
    margin-bottom: auto;
  }

  .hud-top {
    width: min(100%, 590px);
    margin: 0 auto;
  }

  .hud-bottom {
    right: max(28px, calc((100vw - 590px) / 2));
    left: max(28px, calc((100vw - 590px) / 2));
  }

  #leftButton { left: max(28px, calc((100vw - 590px) / 2)); }
  #rightButton { left: max(96px, calc((100vw - 454px) / 2)); }
  .boost-button { right: max(28px, calc((100vw - 590px) / 2)); }
}

@media (hover: hover) and (pointer: fine) {
  .steer-button,
  .boost-button {
    opacity: .45;
  }

  .steer-button:hover,
  .boost-button:hover {
    opacity: 1;
  }
}

@media (orientation: landscape) and (max-height: 560px) {
  .start-screen {
    padding-top: calc(10px + var(--safe-top));
    padding-bottom: calc(10px + var(--safe-bottom));
  }

  .hero {
    top: calc(75px + var(--safe-top));
    left: calc(22px + var(--safe-left));
    width: 42vw;
  }

  .hero h1 { font-size: clamp(43px, 8vw, 74px); }
  .hero-note { max-width: 310px; }

  .start-dock {
    width: min(47vw, 500px);
    margin: auto 0 0 auto;
    padding: 11px;
  }

  .mode-button { min-height: 57px; }
  .car-picker { min-height: 50px; margin: 8px 0; }
  .primary-button { min-height: 50px; }
  .control-hint { display: none; }

  .garage-copy {
    width: min(47vw, 530px);
    margin: auto 0 auto auto;
  }

  .car-rail {
    right: 0;
    bottom: calc(75px + var(--safe-bottom));
    left: 48%;
    padding-left: 12px;
  }

  .garage-select {
    right: calc(18px + var(--safe-right));
    bottom: calc(10px + var(--safe-bottom));
    left: 50%;
    min-height: 50px;
  }

  .hud-bottom { bottom: calc(9px + var(--safe-bottom)); }
  .steer-button,
  .boost-button { bottom: calc(76px + var(--safe-bottom)); }
}

@media (orientation: landscape) and (max-height: 410px) and (max-width: 800px) {
  .rotate-hint { display: block; }
  .start-dock { opacity: .35; pointer-events: none; }
}

@media (max-width: 380px), (max-height: 720px) and (orientation: portrait) {
  .hero { top: max(78px, calc(66px + var(--safe-top))); }
  .hero h1 { font-size: 44px; }
  .hero-note { display: none; }
  .start-dock { padding: 11px; border-radius: 20px; }
  .mode-button { min-height: 58px; }
  .mode-icon { width: 30px; height: 30px; flex-basis: 30px; }
  .mode-button small { display: none; }
  .car-picker { min-height: 50px; margin: 8px 0; }
  .primary-button { min-height: 51px; }
  .control-hint { margin-top: 11px; }
  .garage-copy { margin-bottom: 151px; }
}

@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    scroll-behavior: auto !important;
    animation-duration: .01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: .01ms !important;
  }
}

